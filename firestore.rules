rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function fullUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function self(uid) { return fullUser() && request.auth.uid == uid; }
    function eventOwner(eventId) {
      return fullUser() && get(/databases/$(database)/documents/Events/$(eventId)).data.customerUid == request.auth.uid;
    }
    function orgAdmin(orgId) {
      return fullUser() && get(/databases/$(database)/documents/Organizations/$(orgId)/Members/$(request.auth.uid)).data.role == 'Admin';
    }
    function orgMember(orgId) {
      return signedIn() && get(/databases/$(database)/documents/Organizations/$(orgId)/Members/$(request.auth.uid)).data.status == 'approved';
    }

    // Privileged and derived records are server-only. Admin custom claims do not
    // bypass this rule; the Admin API uses the Admin SDK after server RBAC checks.
    match /admin_roles/{doc} { allow read, write: if false; }
    match /admin_audit_logs/{doc} { allow read, write: if false; }
    match /admin_metrics_daily/{doc} { allow read, write: if false; }
    match /admin_metrics_current/{doc} { allow read, write: if false; }
    match /admin_jobs/{doc} { allow read, write: if false; }
    match /admin_idempotency/{doc} { allow read, write: if false; }
    match /subscriptions/{uid} { allow read: if self(uid); allow write: if false; }
    match /event_analytics/{eventId} { allow read: if eventOwner(eventId); allow write: if false; }
    match /user_analytics/{uid} { allow read: if self(uid); allow write: if false; }
    match /TicketPayments/{doc} { allow read: if signedIn() && resource.data.customerUid == request.auth.uid; allow write: if false; }
    match /TicketUpgradePayments/{doc} { allow read: if signedIn() && resource.data.customerUid == request.auth.uid; allow write: if false; }
    match /FeaturePayments/{doc} { allow read: if signedIn() && resource.data.customerUid == request.auth.uid; allow write: if false; }

    match /Customers/{uid} {
      allow read: if signedIn();
      allow create: if self(uid) && request.resource.data.uid == request.auth.uid;
      allow update: if self(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
      match /followers/{followerId} { allow read: if signedIn(); allow create, delete: if signedIn() && request.auth.uid == followerId; allow update: if false; }
      match /following/{followingId} { allow read: if signedIn(); allow create, delete: if self(uid); allow update: if false; }
      match /{subcollection}/{document} { allow read, write: if self(uid); }
    }

    match /users/{uid} {
      allow read, create, update: if self(uid);
      allow delete: if false;
      match /{subcollection}/{document} { allow read, write: if self(uid); }
    }

    match /Events/{eventId} {
      allow read: if signedIn();
      allow create: if fullUser() && request.resource.data.customerUid == request.auth.uid;
      allow update: if eventOwner(eventId) && request.resource.data.customerUid == resource.data.customerUid;
      allow delete: if eventOwner(eventId);
      match /Attendees/{uid} { allow read: if signedIn(); allow create, update, delete: if signedIn() && (request.auth.uid == uid || eventOwner(eventId)); }
      match /Questions/{id} { allow read: if signedIn(); allow write: if eventOwner(eventId); }
      match /{subcollection}/{document} { allow read: if signedIn(); allow write: if eventOwner(eventId); }
    }

    match /Organizations/{orgId} {
      allow read: if signedIn();
      allow create: if fullUser() && request.resource.data.createdBy == request.auth.uid;
      allow update: if orgAdmin(orgId) && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if orgAdmin(orgId);
      match /Members/{uid} { allow read: if signedIn(); allow create: if fullUser() && (request.auth.uid == uid || orgAdmin(orgId)); allow update, delete: if fullUser() && (request.auth.uid == uid || orgAdmin(orgId)); }
      match /Feed/{id} { allow read: if orgMember(orgId); allow create: if orgMember(orgId) && request.resource.data.createdBy == request.auth.uid; allow update, delete: if orgAdmin(orgId) || (orgMember(orgId) && resource.data.createdBy == request.auth.uid); }
      match /JoinRequests/{uid} { allow create: if fullUser() && request.auth.uid == uid; allow read, delete: if request.auth.uid == uid || orgAdmin(orgId); allow update: if orgAdmin(orgId); }
      match /{subcollection}/{document} { allow read: if orgMember(orgId); allow write: if orgAdmin(orgId); }
    }

    match /OrganizationNames/{name} { allow read: if signedIn(); allow create: if fullUser(); allow update: if false; allow delete: if fullUser() && resource.data.createdBy == request.auth.uid; }
    match /Attendance/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid; allow update, delete: if signedIn() && resource.data.customerUid == request.auth.uid; }
    match /Tickets/{id} { allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || eventOwner(resource.data.eventId)); allow create: if fullUser() && request.resource.data.customerUid == request.auth.uid; allow update: if fullUser() && (resource.data.customerUid == request.auth.uid || eventOwner(resource.data.eventId)); allow delete: if false; }
    match /Conversations/{id} { allow read: if fullUser() && request.auth.uid in resource.data.participantIds; allow create: if fullUser() && request.auth.uid in request.resource.data.participantIds; allow update: if fullUser() && request.auth.uid in resource.data.participantIds && request.auth.uid in request.resource.data.participantIds; allow delete: if false; match /Messages/{messageId} { allow read, create: if fullUser(); allow update, delete: if fullUser() && resource.data.senderId == request.auth.uid; } }
    match /Messages/{id} { allow read: if fullUser() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid); allow create: if fullUser() && request.resource.data.senderId == request.auth.uid; allow update, delete: if fullUser() && resource.data.senderId == request.auth.uid; match /messages/{subId} { allow read, create: if fullUser(); allow update, delete: if fullUser() && resource.data.senderId == request.auth.uid; } }
    match /Comments/{id} { allow read: if signedIn(); allow create: if fullUser() && request.resource.data.userId == request.auth.uid; allow update, delete: if fullUser() && resource.data.userId == request.auth.uid; }
    match /reports/{id} { allow create: if fullUser() && request.resource.data.reporterUid == request.auth.uid; allow read, update, delete: if false; }
    match /event_feedback/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if false; }
    match /notifications/{id} { allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid; allow create: if false; }
    match /notification_history/{id} { allow read: if fullUser() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /scheduledNotifications/{id} { allow read: if fullUser() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /pendingPushNotifications/{id} { allow read, write: if false; }

    // No authenticated catch-all. New collections require an explicit review.
    match /{document=**} { allow read, write: if false; }
  }
}
