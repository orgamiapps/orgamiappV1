rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function fullUser() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        !exists(/databases/$(database)/documents/account_deletion_jobs/$(request.auth.uid));
    }

    function self(uid) {
      return fullUser() && request.auth.uid == uid;
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/Events/$(eventId)).data;
    }

    function eventOwner(eventId) {
      return fullUser() && eventData(eventId).customerUid == request.auth.uid;
    }

    function eventManager(eventId) {
      return fullUser() && (
        eventOwner(eventId) ||
        request.auth.uid in eventData(eventId).get('coHosts', []) ||
        request.auth.uid in eventData(eventId).get('checkInStaff', []) ||
        (eventData(eventId).get('organizationId', '') != '' &&
          orgAdmin(eventData(eventId).organizationId))
      );
    }

    function eventParticipant(eventId) {
      return fullUser() && (
        eventManager(eventId) ||
        request.auth.uid in eventData(eventId).get('accessList', []) ||
        exists(/databases/$(database)/documents/Events/$(eventId)/Attendees/$(request.auth.uid))
      );
    }

    function canReadEvent(eventId) {
      return signedIn() && (
        eventData(eventId).get('private', null) == false ||
        eventParticipant(eventId) ||
        (eventData(eventId).get('organizationId', '') != '' &&
          orgMember(eventData(eventId).organizationId))
      );
    }

    function orgMemberData(orgId) {
      return get(
        /databases/$(database)/documents/Organizations/$(orgId)/Members/$(request.auth.uid)
      ).data;
    }

    function orgMember(orgId) {
      return fullUser() &&
        exists(/databases/$(database)/documents/Organizations/$(orgId)/Members/$(request.auth.uid)) &&
        orgMemberData(orgId).status == 'approved';
    }

    function orgAdmin(orgId) {
      return orgMember(orgId) &&
        orgMemberData(orgId).role in ['Admin', 'admin', 'Owner', 'owner'];
    }

    function conversationParticipant(conversationId) {
      return fullUser() &&
        request.auth.uid in get(
          /databases/$(database)/documents/Conversations/$(conversationId)
        ).data.get('participantIds', []);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Server-owned security, billing, audit, analytics, and derived records.
    match /admin_roles/{doc} { allow read, write: if false; }
    match /admin_audit_logs/{doc} { allow read, write: if false; }
    match /admin_metrics_daily/{doc} { allow read, write: if false; }
    match /admin_metrics_current/{doc} { allow read, write: if false; }
    match /admin_funnel_daily/{doc} { allow read, write: if false; }
    match /product_funnel_events/{doc} { allow read, write: if false; }
    match /admin_jobs/{doc} { allow read, write: if false; }
    match /admin_idempotency/{doc} { allow read, write: if false; }
    match /admin_rate_limits/{doc} { allow read, write: if false; }
    match /service_rate_limits/{doc} { allow read, write: if false; }
    match /ProfileReadLimits/{uid} { allow read, write: if false; }
    match /QualificationScopes/{doc} { allow read, write: if false; }
    match /QualificationBindings/{doc} { allow read, write: if false; }
    match /QualificationCaptures/{doc} { allow read, write: if false; }
    match /stripe_webhook_events/{doc} { allow read, write: if false; }
    match /TicketReservations/{doc} { allow read, write: if false; }
    match /GuestAttendees/{doc} { allow read, write: if false; }
    match /GuestEventEmailClaims/{doc} { allow read, write: if false; }
    match /GuestManageTokens/{doc} { allow read, write: if false; }
    match /GuestManageSessions/{doc} { allow read, write: if false; }
    match /PublicRegistrationFlows/{doc} { allow read, write: if false; }
    match /EventDrafts/{doc} { allow read, write: if false; }
    match /EventTemplates/{doc} { allow read, write: if false; }
    match /EventSeries/{doc} { allow read, write: if false; }
    match /OutboundMessages/{doc} { allow read, write: if false; }
    match /CommunicationTemplates/{doc} { allow read, write: if false; }
    match /payment_review_queue/{doc} { allow read, write: if false; }
    match /PublicWebEvents/{doc} { allow read, write: if false; }
    match /PublicWebCommunities/{doc} { allow read, write: if false; }
    match /account_deletion_jobs/{doc} { allow read, write: if false; }
    match /biometric_quarantine/{doc} { allow read, write: if false; }
    match /FaceEnrollments/{doc} { allow read, write: if false; }
    match /feedback_submissions/{doc} { allow read, write: if false; }
    match /LegacyNotificationDeliveries/{doc} { allow read, write: if false; }
    match /PushTokenBindings/{doc} { allow read, write: if false; }
    match /PushInstallations/{doc} { allow read, write: if false; }
    match /app_feedback/{doc} { allow read, write: if false; }
    match /LiveQuizzes/{doc} { allow read, write: if false; }
    match /LiveQuizSecrets/{document=**} { allow read, write: if false; }
    match /LiveQuizQuestionLookup/{doc} { allow read, write: if false; }
    match /QuizQuestions/{doc} { allow read, write: if false; }
    match /QuizParticipants/{doc} { allow read, write: if false; }
    match /QuizResponses/{doc} { allow read, write: if false; }

    match /subscriptions/{uid} {
      allow read: if self(uid);
      allow write: if false;
    }
    match /account_entitlements/{uid} {
      allow read: if self(uid);
      allow write: if false;
    }
    match /event_analytics/{eventId} {
      allow read: if eventOwner(eventId);
      allow write: if false;
    }
    match /user_analytics/{uid} {
      allow read: if self(uid);
      allow write: if false;
    }
    match /_user_analytics_recompute/{uid} {
      allow read, write: if false;
    }
    match /TicketPayments/{doc} {
      allow read: if fullUser() && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }
    match /TicketUpgradePayments/{doc} {
      allow read: if fullUser() && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }
    match /FeaturePayments/{doc} {
      allow read: if fullUser() && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }

    match /AppConfig/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /Customers/{uid} {
      // Other accounts use the allowlisted public-profile callables.
      allow read: if self(uid);
      allow create: if self(uid) && request.resource.data.uid == request.auth.uid &&
        !request.resource.data.keys().hasAny([
          'role', 'roles', 'isAdmin', 'approved', 'approvalStatus',
          'tier', 'planId', 'subscriptionStatus', 'paid', 'isPaid',
          'eventsCreatedThisMonth', 'usage'
        ]) &&
        request.resource.data.get('eventsCreated', 0) is int &&
        request.resource.data.get('eventsCreated', 0) == 0 &&
        request.resource.data.get('groupsCreated', 0) is int &&
        request.resource.data.get('groupsCreated', 0) == 0;
      allow update: if self(uid) &&
        request.resource.data.uid == resource.data.uid &&
        !changedKeys().hasAny([
          'role', 'roles', 'isAdmin', 'approved', 'approvalStatus',
          'tier', 'planId', 'subscriptionStatus', 'paid', 'isPaid',
          'eventsCreated', 'eventsCreatedThisMonth', 'groupsCreated', 'usage'
        ]);
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if fullUser();
        allow create, delete: if fullUser() && request.auth.uid == followerId;
        allow update: if false;
      }
      match /following/{followingId} {
        allow read: if fullUser();
        allow create, delete: if self(uid);
        allow update: if false;
      }
      match /SavedEvents/{eventId} {
        allow read: if fullUser() && self(uid);
        allow create: if fullUser() && self(uid) &&
          request.resource.data.eventId == eventId &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if fullUser() && self(uid);
        allow update: if false;
      }
      match /Discovery/{document} {
        allow read, create, update, delete: if fullUser() && self(uid);
      }
      match /{subcollection}/{document} {
        allow read, write: if self(uid)
          && subcollection != 'SavedEvents'
          && subcollection != 'Discovery';
      }
    }

    match /users/{uid} {
      allow read: if self(uid);
      allow create: if self(uid) && !request.resource.data.keys().hasAny([
        'role', 'roles', 'isAdmin', 'approved', 'approvalStatus',
        'tier', 'planId', 'subscriptionStatus', 'paid', 'isPaid', 'usage', 'fcmToken'
      ]);
      allow update: if self(uid) && !changedKeys().hasAny([
        'role', 'roles', 'isAdmin', 'approved', 'approvalStatus',
        'tier', 'planId', 'subscriptionStatus', 'paid', 'isPaid', 'usage', 'fcmToken'
      ]);
      allow delete: if false;
      match /{subcollection}/{document} {
        allow read, write: if self(uid);
      }
    }

    match /Events/{eventId} {
      allow read: if signedIn() && (
        resource.data.private == false ||
        resource.data.customerUid == request.auth.uid ||
        request.auth.uid in resource.data.get('coHosts', []) ||
        request.auth.uid in resource.data.get('checkInStaff', []) ||
        request.auth.uid in resource.data.get('accessList', []) ||
        (resource.data.get('organizationId', '') != '' &&
          orgMember(resource.data.organizationId))
      );
      // Publication, schedule/lifecycle, organization and counters are callable-owned.
      // Legacy clients must update to the event wizard for protected mutations.
      allow create: if false;
      allow update: if eventOwner(eventId) &&
        changedKeys().hasOnly(['title', 'description', 'imageUrl', 'updatedAt']);
      // Permanent deletion is server checked for dependent records.
      allow delete: if false;

      match /Attendees/{uid} {
        allow read: if self(uid) || eventManager(eventId);
        allow write: if false;
      }
      match /Comments/{id} {
        allow read: if canReadEvent(eventId);
        allow write: if false;
      }
      match /Questions/{id} {
        allow read: if canReadEvent(eventId);
        allow write: if eventOwner(eventId);
      }
      match /AccessRequests/{uid} {
        allow create: if self(uid) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending';
        allow read, delete: if self(uid) || eventOwner(eventId);
        allow update: if false;
      }
      match /{subcollection}/{document} {
        allow read: if subcollection != 'Attendees' && canReadEvent(eventId);
        allow write: if !(subcollection in ['Attendees', 'Comments', 'AccessRequests']) && eventOwner(eventId);
      }
    }

    match /Organizations/{orgId} {
      allow read: if signedIn();
      allow create: if fullUser() && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name_lowercase is string &&
        getAfter(/databases/$(database)/documents/OrganizationNames/$(request.resource.data.name_lowercase)).data.organizationId == orgId;
      allow update: if orgAdmin(orgId) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (!changedKeys().hasAny(['name_lowercase']) ||
          getAfter(/databases/$(database)/documents/OrganizationNames/$(request.resource.data.name_lowercase)).data.organizationId == orgId);
      allow delete: if orgAdmin(orgId);

      match /Members/{uid} {
        allow read: if orgMember(orgId) || self(uid);
        allow create: if fullUser() && (
          orgAdmin(orgId) ||
          (self(uid) &&
            exists(/databases/$(database)/documents/Organizations/$(orgId)) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.role in ['Member', 'member'] &&
            request.resource.data.status == 'pending' &&
            request.resource.data.get('permissions', []) == []) ||
          (self(uid) &&
            get(/databases/$(database)/documents/Organizations/$(orgId)).data.createdBy == request.auth.uid &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.role in ['Admin', 'admin', 'Owner', 'owner'] &&
            request.resource.data.status == 'approved')
        );
        allow update: if orgAdmin(orgId) ||
          (self(uid) && !changedKeys().hasAny([
            'role', 'permissions', 'status', 'organizationId', 'userId',
            'approvedAt', 'approvedBy'
          ]));
        allow delete: if orgAdmin(orgId) || self(uid);
      }
      match /Feed/{id} {
        allow read: if orgMember(orgId);
        // Author identity, poll votes, comments, counters and moderation are
        // validated atomically by communityMutationV1.
        allow write: if false;
        match /Comments/{commentId} {
          allow read: if orgMember(orgId) &&
            exists(/databases/$(database)/documents/Organizations/$(orgId)/Feed/$(id)) &&
            get(/databases/$(database)/documents/Organizations/$(orgId)/Feed/$(id)).data.get('deleted', false) == false;
          allow write: if false;
        }
      }
      match /JoinRequests/{uid} {
        allow create: if self(uid) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending';
        allow read, delete: if self(uid) || orgAdmin(orgId);
        allow update: if orgAdmin(orgId);
      }
      match /Followers/{uid} {
        allow read: if fullUser();
        allow create: if fullUser() && self(uid) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.organizationId == orgId;
        allow delete: if fullUser() && self(uid);
        allow update: if false;
      }
      match /{subcollection}/{document} {
        allow read: if orgMember(orgId);
        allow write: if subcollection != 'Feed' && orgAdmin(orgId);
      }
    }

    match /OrganizationNames/{name} {
      allow read: if signedIn();
      allow create: if fullUser() &&
        request.resource.data.organizationId is string &&
        getAfter(/databases/$(database)/documents/Organizations/$(request.resource.data.organizationId)).data.name_lowercase == name &&
        (getAfter(/databases/$(database)/documents/Organizations/$(request.resource.data.organizationId)).data.createdBy == request.auth.uid ||
          orgAdmin(request.resource.data.organizationId));
      allow update: if fullUser() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        orgAdmin(resource.data.organizationId) &&
        getAfter(/databases/$(database)/documents/Organizations/$(resource.data.organizationId)).data.name_lowercase == name;
      allow delete: if fullUser() && orgAdmin(resource.data.organizationId);
    }

    match /Attendance/{id} {
      allow read: if fullUser() &&
        (resource.data.customerUid == request.auth.uid ||
          eventManager(resource.data.eventId));
      allow create, update, delete: if false;
    }
    match /RegisterAttendance/{id} {
      allow read: if fullUser() &&
        (resource.data.customerUid == request.auth.uid ||
          eventManager(resource.data.eventId));
      allow write: if false;
    }

    match /Tickets/{id} {
      allow read: if fullUser() &&
        (resource.data.customerUid == request.auth.uid ||
          eventManager(resource.data.eventId));
      allow create: if false;
      allow update, delete: if false;
    }

    match /CheckInSessions/{id} {
      allow read: if eventManager(resource.data.eventId);
      allow write: if false;
    }
    match /CheckInAudit/{id} {
      allow read: if eventManager(resource.data.eventId);
      allow write: if false;
    }
    match /AttendancePasses/{id} { allow read, write: if false; }
    match /AttendanceSubjects/{id} { allow read, write: if false; }
    match /AttendanceSigningKeys/{id} { allow read, write: if false; }
    match /AttendanceWalletDownloads/{id} { allow read, write: if false; }
    match /AttendanceWalletDevices/{id} { allow read, write: if false; }
    match /AttendanceWalletJobs/{id} { allow read, write: if false; }
    match /AttendanceWalletDeliveryJobs/{id} { allow read, write: if false; }
    match /AttendanceWalletDelivery/{id} { allow read, write: if false; }
    match /check_in_session_secrets/{id} { allow read, write: if false; }
    match /check_in_idempotency/{id} { allow read, write: if false; }
    match /check_in_event_state/{id} { allow read, write: if false; }
    match /dwell_times/{id} { allow read, write: if false; }

    match /Conversations/{id} {
      allow read: if fullUser() && request.auth.uid in resource.data.participantIds;
      // Direct conversations and all message writes are server-owned. Group
      // creation remains compatible with the existing group composer.
      allow create: if fullUser() && request.resource.data.isGroup == true &&
        !request.resource.data.keys().hasAny(['redirectConversationId', 'migrationState', 'formerParticipant']) &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() >= 3 &&
        request.resource.data.participantIds.size() <= 100 &&
        request.resource.data.participantIds.toSet().size() == request.resource.data.participantIds.size() &&
        request.resource.data.messagingVersion == 2 &&
        request.resource.data.sequence == 0 &&
        request.resource.data.lastMessage == '' &&
        request.resource.data.receivedTotals == {} && request.resource.data.readTotals == {} &&
        request.resource.data.readSequences == {} && request.resource.data.unreadCounts == {};
      allow update: if fullUser() && request.auth.uid in resource.data.participantIds &&
        !resource.data.keys().hasAny(['redirectConversationId']) &&
        resource.data.get('migrationState', 'complete') != 'moving' &&
        changedKeys().hasOnly(['groupName', 'groupAvatarUrl']);
      allow delete: if false;
      match /Messages/{messageId} {
        allow read: if conversationParticipant(id);
        allow write: if false;
      }
    }

    match /Messages/{id} {
      allow read: if conversationParticipant(resource.data.conversationId);
      allow write: if false;
      match /messages/{subId} {
        allow read: if conversationParticipant(id);
        allow write: if false;
      }
    }

    match /Comments/{id} {
      allow read: if canReadEvent(resource.data.eventId);
      allow create: if fullUser() && request.resource.data.userId == request.auth.uid &&
        canReadEvent(request.resource.data.eventId) &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 4000;
      allow update: if fullUser() && resource.data.userId == request.auth.uid &&
        changedKeys().hasOnly(['comment']) && request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 4000;
      allow delete: if fullUser() && resource.data.userId == request.auth.uid;
    }
    match /reports/{id} {
      allow read, write: if false;
    }
    match /event_feedback/{id} {
      allow read: if fullUser() &&
        (resource.data.userId == request.auth.uid || eventOwner(resource.data.eventId));
      allow write: if false;
    }
    match /notifications/{id} {
      allow read, delete: if fullUser() && resource.data.userId == request.auth.uid;
      allow update: if fullUser() && resource.data.userId == request.auth.uid &&
        changedKeys().hasOnly(['isRead', 'read', 'readAt']);
      allow create: if false;
    }
    match /notification_history/{id} {
      allow read: if fullUser() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /scheduledNotifications/{id} {
      allow read: if fullUser() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /pendingPushNotifications/{id} { allow read, write: if false; }

    // No authenticated catch-all. Every new collection requires an explicit review.
    match /{document=**} { allow read, write: if false; }
  }
}
