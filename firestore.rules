rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function fullUser() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function self(uid) {
      return fullUser() && request.auth.uid == uid;
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/Events/$(eventId)).data;
    }

    function eventOwner(eventId) {
      return fullUser() && eventData(eventId).customerUid == request.auth.uid;
    }

    function eventParticipant(eventId) {
      return fullUser() && (
        eventOwner(eventId) ||
        request.auth.uid in eventData(eventId).get('accessList', []) ||
        exists(/databases/$(database)/documents/Events/$(eventId)/Attendees/$(request.auth.uid))
      );
    }

    function canReadEvent(eventId) {
      return signedIn() && (
        eventData(eventId).get('private', false) == false ||
        eventParticipant(eventId)
      );
    }

    function orgMemberData(orgId) {
      return get(
        /databases/$(database)/documents/Organizations/$(orgId)/Members/$(request.auth.uid)
      ).data;
    }

    function orgMember(orgId) {
      return fullUser() &&
        exists(/databases/$(database)/documents/Organizations/$(orgId)/Members/$(request.auth.uid)) &&
        orgMemberData(orgId).status == 'approved';
    }

    function orgAdmin(orgId) {
      return orgMember(orgId) &&
        orgMemberData(orgId).role in ['Admin', 'admin', 'Owner', 'owner'];
    }

    function conversationParticipant(conversationId) {
      return fullUser() &&
        request.auth.uid in get(
          /databases/$(database)/documents/Conversations/$(conversationId)
        ).data.get('participantIds', []);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Server-owned security, billing, audit, analytics, and derived records.
    match /admin_roles/{doc} { allow read, write: if false; }
    match /admin_audit_logs/{doc} { allow read, write: if false; }
    match /admin_metrics_daily/{doc} { allow read, write: if false; }
    match /admin_metrics_current/{doc} { allow read, write: if false; }
    match /admin_jobs/{doc} { allow read, write: if false; }
    match /admin_idempotency/{doc} { allow read, write: if false; }
    match /admin_rate_limits/{doc} { allow read, write: if false; }
    match /service_rate_limits/{doc} { allow read, write: if false; }
    match /stripe_webhook_events/{doc} { allow read, write: if false; }
    match /account_deletion_jobs/{doc} { allow read, write: if false; }
    match /biometric_quarantine/{doc} { allow read, write: if false; }
    match /FaceEnrollments/{doc} { allow read, write: if false; }

    match /subscriptions/{uid} {
      allow read: if self(uid);
      allow write: if false;
    }
    match /event_analytics/{eventId} {
      allow read: if eventOwner(eventId);
      allow write: if false;
    }
    match /user_analytics/{uid} {
      allow read: if self(uid);
      allow write: if false;
    }
    match /TicketPayments/{doc} {
      allow read: if fullUser() && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }
    match /TicketUpgradePayments/{doc} {
      allow read: if fullUser() && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }
    match /FeaturePayments/{doc} {
      allow read: if fullUser() && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }

    match /Customers/{uid} {
      allow read: if fullUser();
      allow create: if self(uid) && request.resource.data.uid == request.auth.uid;
      allow update: if self(uid) &&
        request.resource.data.uid == resource.data.uid &&
        !changedKeys().hasAny([
          'role', 'roles', 'isAdmin', 'approved', 'approvalStatus',
          'tier', 'planId', 'subscriptionStatus', 'paid', 'isPaid',
          'eventsCreatedThisMonth', 'groupsCreated', 'usage'
        ]);
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if fullUser();
        allow create, delete: if fullUser() && request.auth.uid == followerId;
        allow update: if false;
      }
      match /following/{followingId} {
        allow read: if fullUser();
        allow create, delete: if self(uid);
        allow update: if false;
      }
      match /{subcollection}/{document} {
        allow read, write: if self(uid);
      }
    }

    match /users/{uid} {
      allow read, create: if self(uid);
      allow update: if self(uid) && !changedKeys().hasAny([
        'role', 'roles', 'isAdmin', 'approved', 'approvalStatus',
        'tier', 'planId', 'subscriptionStatus', 'paid', 'isPaid', 'usage'
      ]);
      allow delete: if false;
      match /{subcollection}/{document} {
        allow read, write: if self(uid);
      }
    }

    match /Events/{eventId} {
      allow read: if signedIn() && (
        resource.data.get('private', false) == false ||
        resource.data.customerUid == request.auth.uid ||
        request.auth.uid in resource.data.get('accessList', [])
      );
      allow create: if fullUser() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.get('isFeatured', false) == false &&
        request.resource.data.get('issuedTickets', 0) == 0;
      allow update: if eventOwner(eventId) &&
        request.resource.data.customerUid == resource.data.customerUid &&
        !changedKeys().hasAny([
          'isFeatured', 'featureEndDate', 'issuedTickets', 'paidTicketCount',
          'grossRevenue', 'netRevenue', 'attendanceCount', 'commentCount'
        ]);
      allow delete: if eventOwner(eventId);

      match /Attendees/{uid} {
        allow read: if self(uid) || eventOwner(eventId);
        allow create: if self(uid) && request.resource.data.customerUid == request.auth.uid;
        allow update, delete: if false;
      }
      match /Questions/{id} {
        allow read: if canReadEvent(eventId);
        allow write: if eventOwner(eventId);
      }
      match /AccessRequests/{uid} {
        allow create: if self(uid) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending';
        allow read, delete: if self(uid) || eventOwner(eventId);
        allow update: if eventOwner(eventId);
      }
      match /{subcollection}/{document} {
        allow read: if canReadEvent(eventId);
        allow write: if eventOwner(eventId);
      }
    }

    match /Organizations/{orgId} {
      allow read: if signedIn();
      allow create: if fullUser() && request.resource.data.createdBy == request.auth.uid;
      allow update: if orgAdmin(orgId) &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if orgAdmin(orgId);

      match /Members/{uid} {
        allow read: if orgMember(orgId) || self(uid);
        allow create: if fullUser() && (
          orgAdmin(orgId) ||
          (self(uid) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.role in ['Member', 'member'] &&
            request.resource.data.status in ['pending', 'approved']) ||
          (self(uid) &&
            get(/databases/$(database)/documents/Organizations/$(orgId)).data.createdBy == request.auth.uid &&
            request.resource.data.role in ['Admin', 'admin', 'Owner', 'owner'] &&
            request.resource.data.status == 'approved')
        );
        allow update: if orgAdmin(orgId) ||
          (self(uid) && !changedKeys().hasAny([
            'role', 'permissions', 'status', 'organizationId', 'userId',
            'approvedAt', 'approvedBy'
          ]));
        allow delete: if orgAdmin(orgId) || self(uid);
      }
      match /Feed/{id} {
        allow read: if orgMember(orgId);
        allow create: if orgMember(orgId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if orgAdmin(orgId) ||
          (orgMember(orgId) && resource.data.createdBy == request.auth.uid);
      }
      match /JoinRequests/{uid} {
        allow create: if self(uid) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending';
        allow read, delete: if self(uid) || orgAdmin(orgId);
        allow update: if orgAdmin(orgId);
      }
      match /{subcollection}/{document} {
        allow read: if orgMember(orgId);
        allow write: if orgAdmin(orgId);
      }
    }

    match /OrganizationNames/{name} {
      allow read: if signedIn();
      allow create: if fullUser();
      allow update: if false;
      allow delete: if fullUser() && resource.data.createdBy == request.auth.uid;
    }

    match /Attendance/{id} {
      allow read: if fullUser() &&
        (resource.data.customerUid == request.auth.uid || eventOwner(resource.data.eventId));
      allow create: if fullUser() &&
        request.resource.data.customerUid == request.auth.uid &&
        canReadEvent(request.resource.data.eventId);
      allow update, delete: if false;
    }
    match /RegisterAttendance/{id} {
      allow read: if fullUser() &&
        (resource.data.customerUid == request.auth.uid || eventOwner(resource.data.eventId));
      allow create: if fullUser() &&
        request.resource.data.customerUid == request.auth.uid &&
        canReadEvent(request.resource.data.eventId);
      allow update, delete: if false;
    }

    match /Tickets/{id} {
      allow read: if fullUser() &&
        (resource.data.customerUid == request.auth.uid || eventOwner(resource.data.eventId));
      allow create: if fullUser() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.get('isPaid', false) == false &&
        request.resource.data.get('isUsed', false) == false &&
        request.resource.data.get('isSkipTheLine', false) == false;
      allow update: if eventOwner(resource.data.eventId) &&
        changedKeys().hasOnly(['isUsed', 'usedDateTime', 'usedBy']);
      allow delete: if false;
    }

    match /Conversations/{id} {
      allow read: if fullUser() && request.auth.uid in resource.data.participantIds;
      allow create: if fullUser() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() >= 2 &&
        request.resource.data.participantIds.size() <= 100;
      allow update: if fullUser() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /Messages/{messageId} {
        allow read: if conversationParticipant(id);
        allow create: if conversationParticipant(id) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.conversationId == id;
        allow update: if conversationParticipant(id) && (
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId) ||
          changedKeys().hasOnly(['isRead', 'readByUserIds'])
        );
        allow delete: if conversationParticipant(id) &&
          resource.data.senderId == request.auth.uid;
      }
    }

    match /Messages/{id} {
      allow read: if conversationParticipant(resource.data.conversationId);
      allow create: if fullUser() &&
        request.resource.data.senderId == request.auth.uid &&
        conversationParticipant(request.resource.data.conversationId);
      allow update: if conversationParticipant(resource.data.conversationId) &&
        changedKeys().hasOnly(['isRead', 'readByUserIds']);
      allow delete: if conversationParticipant(resource.data.conversationId) &&
        resource.data.senderId == request.auth.uid;

      match /messages/{subId} {
        allow read: if conversationParticipant(id);
        allow create: if conversationParticipant(id) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.conversationId == id;
        allow update, delete: if conversationParticipant(id) &&
          resource.data.senderId == request.auth.uid;
      }
    }

    match /Comments/{id} {
      allow read: if signedIn();
      allow create: if fullUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if fullUser() && resource.data.userId == request.auth.uid;
    }
    match /reports/{id} {
      allow create: if fullUser() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /event_feedback/{id} {
      allow read: if fullUser() &&
        (resource.data.userId == request.auth.uid || eventOwner(resource.data.eventId));
      allow create: if fullUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /notifications/{id} {
      allow read, update, delete: if fullUser() && resource.data.userId == request.auth.uid;
      allow create: if false;
    }
    match /notification_history/{id} {
      allow read: if fullUser() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /scheduledNotifications/{id} {
      allow read: if fullUser() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /pendingPushNotifications/{id} { allow read, write: if false; }

    // No authenticated catch-all. Every new collection requires an explicit review.
    match /{document=**} { allow read, write: if false; }
  }
}
