{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint . --ext .js --max-warnings=0",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "test": "node --test test/admin-unit.test.js test/places.test.js test/places-rate-limit.test.js test/callable-security.test.js test/account-deletion.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-attendus-admin --only firestore,storage \"node --test --test-concurrency=1 test/firestore-rules.test.js test/storage-rules.test.js\"",
    "test:integration": "firebase emulators:exec --config ../firebase.json --project demo-attendus-admin --only auth,firestore,storage,functions \"node --test --test-concurrency=1 test/admin-emulator.test.js\"",
    "bootstrap:super-admin": "node admin/bootstrap-super-admin.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "archiver": "^8.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^11.0.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "stripe": "^22.4.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^8.15.0",
    "firebase": "^11.10.0"
  },
  "private": true
}
