{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint . --ext .js --max-warnings=0",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "test": "node --test test/admin-unit.test.js test/places.test.js test/places-rate-limit.test.js test/callable-security.test.js test/account-deletion.test.js test/biometric-retention.test.js test/ticket-issuance.test.js test/guest-experience.test.js test/attendance-v2.test.js test/scheduled-reminders.test.js test/discovery-marketplace.test.js test/discovery-categories.test.js test/public-web.test.js test/public-checkout.test.js test/accountless-registration.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.test.json --project demo-attendus-admin --only firestore,storage \"node --test --test-concurrency=1 test/firestore-rules.test.js test/storage-rules.test.js\"",
    "test:integration": "node tools/run-integration-tests.js --project demo-attendus-admin",
    "test:integration:repeat": "node tools/run-integration-tests.js --project demo-attendus-admin --repeat 3",
    "bootstrap:super-admin": "node admin/bootstrap-super-admin.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "biometrics:inventory": "node tools/biometric-retention.js",
    "attendance:migrate": "node tools/migrate-attendance-v2.js",
    "reminders:reconcile": "node tools/reconcile-scheduled-reminders.js",
    "reminders:canary": "node tools/canary-scheduled-reminders.js",
    "discovery:backfill": "node tools/backfill-discovery-marketplace.js",
    "discovery:migrate-saves": "node tools/migrate-saved-events.js",
    "discovery:validate-release": "node tools/validate-discovery-release.js",
    "discovery:backfill-categories": "node tools/backfill-discovery-categories.js",
    "public-web:backfill": "node tools/backfill-public-web.js",
    "public-web:validate": "node tools/validate-public-web.js",
    "public-web:rollout": "node tools/set-public-web-rollout.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "archiver": "^8.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "geofire-common": "^6.0.0",
    "google-auth-library": "^11.0.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "stripe": "^22.4.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^8.15.0",
    "firebase": "^11.10.0",
    "firebase-tools": "15.25.1"
  },
  "private": true
}
