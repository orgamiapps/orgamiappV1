{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "echo 'Linting disabled'",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "test": "node --test test/admin-unit.test.js test/places.test.js test/callable-security.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-attendus-admin --only firestore,storage \"node --test --test-concurrency=1 test/firestore-rules.test.js test/storage-rules.test.js\"",
    "test:integration": "firebase emulators:exec --config ../firebase.json --project demo-attendus-admin --only auth,firestore,functions \"node --test test/admin-emulator.test.js\"",
    "bootstrap:super-admin": "node admin/bootstrap-super-admin.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "archiver": "^6.0.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "google-auth-library": "^9.14.1",
    "googleapis": "^128.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "stripe": "^14.10.0",
    "twilio": "^4.21.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^11.10.0"
  },
  "private": true
}
